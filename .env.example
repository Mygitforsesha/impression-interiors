## Cloudinary (unsigned upload)
REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloud_name
REACT_APP_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

## GitHub Contents API (projects JSON storage)
REACT_APP_GITHUB_OWNER=your_github_username_or_org
REACT_APP_GITHUB_REPO=your_repo_name
REACT_APP_GITHUB_BRANCH=main
REACT_APP_GITHUB_PROJECTS_PATH=data/projects.json
REACT_APP_GITHUB_LEADS_PATH=data/leads.json
REACT_APP_GITHUB_TOKEN=ghp_your_token_here

## Formspree
REACT_APP_FORMSPREE_ENDPOINT=https://formspree.io/f/your_id

## Admin (client-side only)
REACT_APP_ADMIN_USERNAME=admin
REACT_APP_ADMIN_PASSWORD=change_me

## Social / contact links
REACT_APP_WHATSAPP_URL=https://wa.me/919999999999
REACT_APP_PHONE_URL=tel:+919999999999
REACT_APP_INSTAGRAM_URL=https://instagram.com/yourprofile
